# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Supabase (required) ---
# Dashboard → Project Settings → API. Use the secret (service-role) key:
# the server writes to the `documents` and `collections` tables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_KEY is accepted as a fallback name for the same key.

# --- Gemini embeddings (required) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional ---
# EMBEDDING_MODEL=gemini-embedding-2   # or gemini-embedding-001 (vectors are not interchangeable)
# EMBEDDING_DIM=768   # must match vector(768) in migrations/001_init.sql
